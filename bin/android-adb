#!/usr/bin/env python3
"""Entry point on PATH (plugin bin/ or a cloned checkout); runs tools/android."""

import os
import sys

target = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "tools", "android")
os.execv(sys.executable, [sys.executable, os.path.normpath(target), *sys.argv[1:]])
