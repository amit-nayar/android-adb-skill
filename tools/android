def cmd_wait_element(args):
    device_id = choose_device(args.device)
    start = time.time()
    deadline = start + args.timeout / 1000.0
    last_error = None
    while time.time() < deadline:
        try:
            _, elements = load_ui_elements(device_id)
        except ToolError as exc:
            # UI dumps fail transiently during animations, but a vanished device never recovers.
            if not is_device_ready(device_id):
                raise ToolError(f"Device {device_id} is no longer connected. Last error: {exc}") from exc
            last_error = str(exc)
            time.sleep(args.interval / 1000.0)
            continue
        last_error = None
        matches = find_elements(elements, args.by, args.value, args.exact)
        if matches:
            print_output(
                {
                    "deviceId": device_id,
                    "selector": selector_payload(args),
                    "elapsedMs": int((time.time() - start) * 1000),
                    "element": matches[0],
                },
                args.json,
            )
            return
        time.sleep(args.interval / 1000.0)
    detail = f" The last UI dump failed: {last_error}" if last_error else ""
    raise ToolError(f'Element {args.by}="{args.value}" did not appear within {args.timeout}ms.{detail}')


def scroll_swipe(area, direction):
    """Return swipe start/end points that reveal content in `direction` within `area`."""
    left, top = area["x"], area["y"]
    width, height = area["width"], area["height"]
    center_x = left + round(width / 2)
    center_y = top + round(height / 2)
    near_y, far_y = top + round(height * 0.25), top + round(height * 0.75)
    near_x, far_x = left + round(width * 0.25), left + round(width * 0.75)
    # Revealing content below means dragging the finger up, and so on.
    return {
        "down": (center_x, far_y, center_x, near_y),
        "up": (center_x, near_y, center_x, far_y),
        "right": (far_x, center_y, near_x, center_y),
        "left": (near_x, center_y, far_x, center_y),
    }[direction]


def resolve_scroll_area(device_id, elements, args):
    if not args.container_by:
        width, height = get_screen_size(device_id)
        return {"x": 0, "y": 0, "width": width, "height": height}
    containers = find_elements(elements, args.container_by, args.container_value, exact=False)
    if not containers:
        raise ToolError(f'No scroll container found for {args.container_by}="{args.container_value}"')
    return containers[0]["bounds"]


def cmd_scroll_find(args):
    if bool(args.container_by) != bool(args.container_value):
        raise ToolError("Pass --container-by and --container-value together.")
    device_id = choose_device(args.device)
    previous_signature = None
    area = None

    for scroll_count in range(args.max_scrolls + 1):
        _, elements = load_ui_elements(device_id)
        matches = find_elements(elements, args.by, args.value, args.exact)
        if matches:
            print_output(
                {
                    "deviceId": device_id,
                    "selector": selector_payload(args),
                    "direction": args.direction,
                    "scrolls": scroll_count,
                    "element": matches[0],
                },
                args.json,
            )
            return

        if scroll_count == args.max_scrolls:
            break

        signature = json.dumps(elements, sort_keys=True)
        if signature == previous_signature:
            break
        previous_signature = signature

        if area is None:
            area = resolve_scroll_area(device_id, elements, args)
        x1, y1, x2, y2 = scroll_swipe(area, args.direction)
        adb_text(
            ["shell", "input", "swipe", str(x1), str(y1), str(x2), str(y2), str(args.duration)],
            device_id=device_id,
            timeout=10,
        )
        time.sleep(args.pause / 1000.0)

    raise ToolError(f'Element {args.by}="{args.value}" was not found after scrolling {args.direction}.')


def cmd_app_install(args):
    device_id = choose_device(args.device)
    apk_path = pathlib.Path(args.apk)
    if not apk_path.exists():
        raise ToolError(f"APK not found: {apk_path}")

    output = adb_text(["install", "-r", str(apk_path)], device_id=device_id, timeout=90)
    package_name = args.package or detect_package_from_apk(str(apk_path))
    payload = {
        "deviceId": device_id,
        "apk": str(apk_path.resolve()),
        "packageName": package_name,
        "output": output.strip(),
    }
    print_output(payload, args.json)


